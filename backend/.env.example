# PostgreSQL connection string (Render Postgres или Neon)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Порт (Render подставит сам через process.env.PORT, локально можно оставить 4000)
PORT=4000

# Домен(ы) фронтенда через запятую, например:
# CORS_ORIGIN="https://mereitoi.vercel.app"
CORS_ORIGIN="*"

# Ключ для просмотра списка гостей через GET /api/rsvp (заголовок x-admin-key)
ADMIN_KEY="change-me-to-something-secret"
